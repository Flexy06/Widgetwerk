<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView android:id="@+id/bg" android:layout_width="match_parent" android:layout_height="match_parent"
        android:scaleType="fitXY" android:importantForAccessibility="no" />
    <LinearLayout
        android:id="@+id/box"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_vertical|start"
        android:orientation="vertical"
        android:paddingHorizontal="22dp">
        <TextClock android:id="@+id/dow" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:fontFamily="google-sans" android:textFontWeight="600" android:includeFontPadding="false"
            android:format12Hour="EEEE" android:format24Hour="EEEE" android:maxLines="1" android:textSize="18sp" />
        <TextClock android:id="@+id/day" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:fontFamily="google-sans" android:textFontWeight="400" android:includeFontPadding="false"
            android:format12Hour="MMMM d" android:format24Hour="d. MMMM" android:maxLines="1" android:textSize="40sp" />
        <TextClock android:id="@+id/month" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:visibility="gone" android:format12Hour="yyyy" android:format24Hour="yyyy" />
    </LinearLayout>
</FrameLayout>
